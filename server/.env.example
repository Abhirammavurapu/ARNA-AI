# ARNA server configuration. Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins (add your Vercel URL in production)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# ---- AI provider -------------------------------------------------------------
# Leave AI_PROVIDER empty to auto-pick whichever key below is filled in.
# gemini = Google Gemini (has a free tier: https://aistudio.google.com/apikey)
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: override API base URLs (proxies / testing)
GEMINI_BASE_URL=
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=

# ---- Authentication / MongoDB -----------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
